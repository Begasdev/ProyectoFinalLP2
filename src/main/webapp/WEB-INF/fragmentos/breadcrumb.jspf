<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%
    String breadcrumb = (String) request.getAttribute("breadcrumb");
    if (breadcrumb == null) breadcrumb = (String) pageContext.getAttribute("breadcrumb");
    if (breadcrumb == null) breadcrumb = "";
    String[] parts = breadcrumb.split(" / ");
%>
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="${pageContext.request.contextPath}/inicio"><i class="fa-solid fa-house me-1"></i>Inicio</a></li>
        <% for (int i = 0; i < parts.length; i++) { %>
        <% if (i == parts.length - 1) { %>
        <li class="breadcrumb-item active" aria-current="page"><%= parts[i] %></li>
        <% } else { %>
        <li class="breadcrumb-item"><%= parts[i] %></li>
        <% } %>
        <% } %>
    </ol>
</nav>
